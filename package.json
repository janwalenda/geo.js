{
  "name": "@janwalenda/geo",
  "version": "0.1.2",
  "description": "A math-based 2D/3D engine that renders to Canvas and SVG.",
  "keywords": [
    "3d",
    "2d",
    "engine",
    "geometry",
    "math",
    "canvas",
    "svg",
    "rendering"
  ],
  "author": "Jan Walenda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janwalenda/geo.js.git"
  },
  "homepage": "https://github.com/janwalenda/geo.js#readme",
  "bugs": {
    "url": "https://github.com/janwalenda/geo.js/issues"
  },
  "type": "module",
  "main": "./dist/geo.cjs",
  "module": "./dist/geo.js",
  "types": "./dist/geo.d.ts",
  "unpkg": "./dist/geo.umd.min.js",
  "jsdelivr": "./dist/geo.umd.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/geo.d.ts",
        "default": "./dist/geo.js"
      },
      "require": {
        "types": "./dist/geo.d.cts",
        "default": "./dist/geo.cjs"
      }
    },
    "./min": {
      "types": "./dist/geo.d.ts",
      "default": "./dist/geo.min.js"
    },
    "./umd": "./dist/geo.umd.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "rollup -c",
    "test:dist": "node test/dist/verify-dist.mjs",
    "preview": "vite preview",
    "prepublishOnly": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.2",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.5.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "rollup": "^4.68.4",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
